// use prisma-next

// ─── Enums ───────────────────────────────────────────────

enum UserStatus {
  @@type("pg/text@1")
  active    = "active"
  suspended = "suspended"
}

enum OrganizationStatus {
  @@type("pg/text@1")
  active    = "active"
  suspended = "suspended"
}

enum MembershipStatus {
  @@type("pg/text@1")
  active    = "active"
  invited   = "invited"
  suspended = "suspended"
}

// ─── Identity ────────────────────────────────────────────

model User {
  id                     String           @id @default(uuid())
  email                  String
  emailNormalized        String           @unique
  passwordHash           String?
  name                   String?
  avatarUrl              String?
  status                 UserStatus       @default(active)
  emailVerifiedAt        TimestamptzString?
  lastLoginAt            TimestamptzString?
  defaultOrganizationId  String?
  locale                 String?
  timezone               String?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  // relations — identity
  sessions                Session[]
  oauthAccounts           OAuthAccount[]
  emailVerifications      EmailVerification[]
  passwordResets          PasswordReset[]

  // relations — multi-tenant
  memberships             Membership[]        @relation("UserMemberships")
  invitedMemberships      Membership[]        @relation("InvitedByUser")
  invitationsSent         Invitation[]
  ownedOrganizations      Organization[]      @relation("OrganizationOwner")
  defaultOrganization     Organization?       @relation("DefaultOrganizationUser", fields: [defaultOrganizationId], references: [id], onDelete: SetNull)

  @@index([email])
}

model Session {
  id                     String           @id @default(uuid())
  userId                 String
  tokenHash              String           @unique
  expiresAt              TimestamptzString
  revokedAt              TimestamptzString?
  lastSeenAt             TimestamptzString?
  ipAddress              String?
  userAgent              String?
  activeOrganizationId   String?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization     Organization?    @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeOrganizationId])
}

model OAuthAccount {
  id                     String           @id @default(uuid())
  userId                 String
  provider               String
  providerAccountId      String
  providerEmail          String?
  accessTokenEncrypted   String?
  refreshTokenEncrypted  String?
  scopes                 String?
  tokenExpiresAt         TimestamptzString?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerification {
  id                     String           @id @default(uuid())
  userId                 String
  email                  String
  tokenHash              String           @unique
  expiresAt              TimestamptzString
  consumedAt             TimestamptzString?
  createdAt              TimestamptzString @default(now())

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id                     String           @id @default(uuid())
  userId                 String
  tokenHash              String           @unique
  expiresAt              TimestamptzString
  consumedAt             TimestamptzString?
  createdAt              TimestamptzString @default(now())

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Multi-Tenant ────────────────────────────────────────

model Organization {
  id                     String             @id @default(uuid())
  name                   String
  slug                   String             @unique
  billingEmail           String?
  ownerUserId            String?
  personal               Boolean            @default(false)
  status                 OrganizationStatus @default(active)
  logoUrl                String?
  metadata               Json?
  createdAt              TimestamptzString  @default(now())
  updatedAt              temporal.updatedAtString()

  // relations
  owner                  User?              @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  defaultOrganizationUsers User[]           @relation("DefaultOrganizationUser")
  memberships            Membership[]
  invitations            Invitation[]
  roles                  Role[]
  activeSessions         Session[]          @relation("SessionActiveOrganization")

  @@index([ownerUserId])
}

model Membership {
  id                     String           @id @default(uuid())
  organizationId         String
  userId                 String
  roleId                 String
  status                 MembershipStatus @default(active)
  joinedAt               TimestamptzString?
  invitedByUserId        String?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role                   Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedByUser          User?            @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id                     String           @id @default(uuid())
  organizationId         String?
  key                    String
  name                   String
  description            String?
  isSystem               Boolean          @default(false)
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  organization           Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships            Membership[]
  invitations            Invitation[]
  rolePermissions        RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id                     String           @id @default(uuid())
  key                    String           @unique
  resource               String
  action                 String
  description            String?
  createdAt              TimestamptzString @default(now())

  rolePermissions        RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId                 String
  permissionId           String
  createdAt              TimestamptzString @default(now())

  role                   Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission             Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Invitation {
  id                     String           @id @default(uuid())
  organizationId         String
  email                  String
  roleId                 String
  tokenHash              String           @unique
  invitedByUserId        String
  expiresAt              TimestamptzString
  acceptedAt             TimestamptzString?
  revokedAt              TimestamptzString?
  createdAt              TimestamptzString @default(now())

  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                   Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedByUser          User             @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
}
