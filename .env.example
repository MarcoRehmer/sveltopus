# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Email Configuration
# Provider: "scaleway" or "brevo" (default: scaleway)
EMAIL_PROVIDER="scaleway"

# Sender information (required for all providers)
EMAIL_SENDER_NAME=""
EMAIL_SENDER_EMAIL="foo@bar.com"

# Scaleway TEM Configuration (required if EMAIL_PROVIDER="scaleway")
EMAIL_SCW_PROJECT_ID=""
EMAIL_SCW_API_TOKEN=""
EMAIL_SCW_REGION="fr-par"

# Brevo Configuration (required if EMAIL_PROVIDER="brevo")
EMAIL_BREVO_API_KEY=""
